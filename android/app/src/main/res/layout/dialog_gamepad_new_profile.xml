<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gamepad_panel"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:letterSpacing="0.08"
        android:text="@string/settings_gamepad_mapper"
        android:textAllCaps="true"
        android:textColor="@color/design_signal_violet"
        android:textFontWeight="600"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/inter"
        android:text="@string/gamepad_mapper_new_profile"
        android:textColor="@color/design_cloud_white"
        android:textFontWeight="500"
        android:textSize="22sp" />

    <EditText
        android:id="@+id/profile_name_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_gamepad_input"
        android:fontFamily="@font/inter"
        android:hint="@string/gamepad_mapper_profile_name"
        android:imeOptions="actionDone"
        android:inputType="textCapSentences"
        android:maxLines="1"
        android:padding="16dp"
        android:singleLine="true"
        android:textColor="@color/design_cloud_white"
        android:textColorHint="@color/design_quiet_slate"
        android:textFontWeight="400"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/profile_name_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/inter"
        android:textColor="@color/design_signal_violet"
        android:textFontWeight="500"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_cancel"
            style="@style/Widget.Twinpad.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gamepad_mapper_cancel" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/profile_create"
            style="@style/Widget.Twinpad.Button.Filled"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/gamepad_mapper_create" />
    </LinearLayout>
</LinearLayout>
