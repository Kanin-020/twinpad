<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_content"
        android:background="@color/design_void_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- CR-097: lista de conexiones guardadas en SavedDevicesFragment. -->
        <FrameLayout
            android:id="@+id/saved_devices_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CR-097 paso 1: panel de conexión en PairingFragment (fragment_pairing.xml). -->
        <FrameLayout
            android:id="@+id/pairing_fragment_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- CR-097 paso 3: vista de sesión en SessionFragment (fragment_session.xml). -->
        <FrameLayout
            android:id="@+id/session_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <com.twinpad.android.app.ui.GyroMonitorView
            android:id="@+id/gyro_monitor"
            android:layout_width="240dp"
            android:layout_height="152dp"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation drawer (Material): ítems de navegación arriba y el
         formulario de ajustes debajo (drawer_settings). -->
    <LinearLayout
        android:id="@+id/settings_drawer_content"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/design_steel_panel"
        android:orientation="vertical">

        <include
            layout="@layout/drawer_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="8dp"
            android:background="@color/design_slate_edge" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/navigation_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:paddingVertical="8dp"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/nav_new_connection"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_nav_new_connection"
                app:checkedIconVisible="false"
                app:chipIconVisible="true"
                app:chipIconSize="24dp"
                app:chipBackgroundColor="@color/chip_nav_background"
                app:chipStrokeColor="@color/design_slate_edge"
                app:chipStrokeWidth="1dp"
                app:chipIconTint="@color/design_cloud_white"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="48dp"
                app:chipMinTouchTargetSize="48dp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/nav_session"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_nav_session"
                app:checkedIconVisible="false"
                app:chipIconVisible="true"
                app:chipIconSize="24dp"
                app:chipBackgroundColor="@color/chip_nav_background"
                app:chipStrokeColor="@color/design_slate_edge"
                app:chipStrokeWidth="1dp"
                app:chipIconTint="@color/design_cloud_white"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="48dp"
                app:chipMinTouchTargetSize="48dp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/nav_connection_list"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_nav_connection_list"
                app:checkedIconVisible="false"
                app:chipIconVisible="true"
                app:chipIconSize="24dp"
                app:chipBackgroundColor="@color/chip_nav_background"
                app:chipStrokeColor="@color/design_slate_edge"
                app:chipStrokeWidth="1dp"
                app:chipIconTint="@color/design_cloud_white"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="48dp"
                app:chipMinTouchTargetSize="48dp"
                app:chipStartPadding="12dp"
                app:chipEndPadding="12dp"
                app:textStartPadding="0dp"
                app:textEndPadding="0dp" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
