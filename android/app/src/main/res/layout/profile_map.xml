<?xml version="1.0" encoding="utf-8"?>
<!--
    MAPEO TÁCTIL DE CONTROLES (CR-067) — se edita AQUÍ, desde Android Studio,
    con drag & drop en el editor de diseño:

      * Arrastra un com.twinpad.android.app.surface.TwinpadControlView
        dentro de este ConstraintLayout: cada control está anclado a los
        BORDES del parent (left/right y top/bottom) con bias, así que
        moverlo en el editor solo cambia el bias, sin guidelines propias.
      * La única referencia es la CRUZ del 50 % (guidelines map_gx/map_gy).
      * Cada control declara: android:id (id del perfil), app:twinpadKind
        (button|dpad|stick), app:twinpadLabel (1–16) y app:twinpadHid
        (Elemento HID de SPEC-004 §2; sin attr = sin asignar).
      * Posición y tamaño van en PORCENTAJES (0…1) respecto a la
        superficie, válidos en cualquier teléfono:
          x = horizontal_bias × (1 − width_percent)
          y = vertical_bias   × (1 − height_percent)
      * Invariantes de simetría (ajuste fino, CR-069): los pares
        espejo comparten y exacta y sus centros cumplen cx_d = 1 − cx_i;
        select/start son simétricos respecto a cx=0.5 (gap 0.286);
        stick_left/right y L3/R3 comparten fila (cy 0.801 / 0.815);
        el D-pad alinea su centro con la fila del clúster de cara
        Y/X/A/B (cy 0.3515 ambos: CR-071 ronda 2, ambos clústeres suben
        ~1.5 %; el D-pad en vertical_bias 0.2879 →
        cy = 0.2879·0.70 + 0.15 = 0.3515), que va en dp formando un
        rombo cuadrado en px alrededor de su eje invisible
        `face_axis` (cx 0.824, cy 0.3515); ver la sección del
        clúster para los detalles.
      * Formas y colores: res/drawable (touch_button = cara clara,
        bg_control = plato/halo oscuro, stick_thumb = pulgar del stick;
        el D-pad toma el mismo estilo del renderer).
      * Validación compartida con el modelo: ≤ 24 controles, coords 0…1,
        stick→stick_l/r, dpad→dpad.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.twinpad.android.app.ui.ProfileSurface">

    <!-- Cruz de referencia única (50 % vertical + 50 % horizontal). -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/map_gx"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.50" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/map_gy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.50" />

    <!-- ===== banda media: L2/R2 interiores + L1/R1 en los bordes ===== -->

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/trigger_l"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintHorizontal_bias="0.264"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.597"
        app:layout_constraintWidth_percent="0.13"
        app:twinpadHid="trigger_l2"
        app:twinpadKind="button"
        app:twinpadLabel="L2" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_l1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintHorizontal_bias="0.021"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.597"
        app:layout_constraintWidth_percent="0.12"
        app:twinpadHid="button_l1"
        app:twinpadKind="button"
        app:twinpadLabel="L1" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_r1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintHorizontal_bias="0.979"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.597"
        app:layout_constraintWidth_percent="0.12"
        app:twinpadHid="button_r1"
        app:twinpadKind="button"
        app:twinpadLabel="R1" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/trigger_r"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.10"
        app:layout_constraintHorizontal_bias="0.736"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.597"
        app:layout_constraintWidth_percent="0.13"
        app:twinpadHid="trigger_r2"
        app:twinpadKind="button"
        app:twinpadLabel="R2" />

    <!-- ===== select/start: simétricos respecto a cx = 0.5 ===== -->

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_select"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintHorizontal_bias="0.343"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.402"
        app:layout_constraintWidth_percent="0.09"
        app:twinpadHid="button_select"
        app:twinpadKind="button"
        app:twinpadLabel="Select" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.11"
        app:layout_constraintHorizontal_bias="0.657"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.402"
        app:layout_constraintWidth_percent="0.09"
        app:twinpadHid="button_start"
        app:twinpadKind="button"
        app:twinpadLabel="Start" />

    <!-- ===== cruz + sticks (L3/R3 junto a cada stick, misma fila) =====

         CR-071: plato mayor (width_percent 0.27; el radio del plato es
         el lado menor) y centro alineado a la fila del clúster de cara
         (vertical_bias 0.2879 → cy = 0.2879·(1−0.30) + 0.15 = 0.3515;
         ronda 2: antes 0.24 y fila 0.3665). -->

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/dpad_cross"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.30"
        app:layout_constraintHorizontal_bias="0.088"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2879"
        app:layout_constraintWidth_percent="0.27"
        app:twinpadHid="dpad"
        app:twinpadKind="dpad"
        app:twinpadLabel="D-pad" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/stick_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.24"
        app:layout_constraintHorizontal_bias="0.108"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.908"
        app:layout_constraintWidth_percent="0.18"
        app:twinpadHid="stick_l"
        app:twinpadKind="stick"
        app:twinpadLabel="L" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_l3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.297"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.854"
        app:layout_constraintWidth_percent="0.09"
        app:layout_constraintHeight_percent="0.11"
        app:twinpadKind="button"
        app:twinpadLabel="L3"
        app:twinpadHid="button_l3" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/stick_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.24"
        app:layout_constraintHorizontal_bias="0.891"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.908"
        app:layout_constraintWidth_percent="0.18"
        app:twinpadHid="stick_r"
        app:twinpadKind="stick"
        app:twinpadLabel="R" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/button_r3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.703"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.854"
        app:layout_constraintWidth_percent="0.09"
        app:layout_constraintHeight_percent="0.11"
        app:twinpadKind="button"
        app:twinpadLabel="R3"
        app:twinpadHid="button_r3" />

    <!--
        ===== botones de cara Y/X/A/B (rombo en dp, cuadrado en px) =====

        En PORCENTAJE el rombo se estira con el aspecto real de la pantalla
        (la distancia X↔B multiplica el ANCHO y la Y↔A el ALTO): en el
        editor se ve bien pero en el teléfono queda distorsionado. Se
        ancla a un eje INVISIBLE (face_axis) en (cx 0.824, cy 0.3515 — la
        misma fila del D-pad; CR-071 ronda 2, sube ~1.5 %) y cada botón
        va en CONSTRAINTS CIRCULARES:
        mismo radio (60 dp) y ángulos COMPAS desde el norte (0=arriba,
        90=derecha, 180=abajo, 270=izquierda), diámetro fijo 56 dp
        (≥ 0.05 de la superficie en el fixture de tests y en móviles)
        → rombo matemáticamente cuadrado en cualquier aspecto. En el
        editor, mover el clúster = arrastrar face_axis; D y radio se
        editan a mano. Separación centro-a-centro = R·√2 ≈ 85 dp,
        hueco ≈ 29 dp y los halos (1.44×D ≈ 81 dp) casi tangentes.
    -->
    <Space
        android:id="@+id/face_axis"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.824"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3515" />

    <!-- Brújula: Y arriba (0°); X izquierda (270°); B derecha (90°); A abajo (180°). -->
    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/btn_y"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintCircle="@id/face_axis"
        app:layout_constraintCircleAngle="0"
        app:layout_constraintCircleRadius="60dp"
        app:twinpadHid="button_y"
        app:twinpadKind="button"
        app:twinpadLabel="Y" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/btn_x"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintCircle="@id/face_axis"
        app:layout_constraintCircleAngle="270"
        app:layout_constraintCircleRadius="60dp"
        app:twinpadHid="button_x"
        app:twinpadKind="button"
        app:twinpadLabel="X" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/btn_a"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintCircle="@id/face_axis"
        app:layout_constraintCircleAngle="180"
        app:layout_constraintCircleRadius="60dp"
        app:twinpadHid="button_a"
        app:twinpadKind="button"
        app:twinpadLabel="A" />

    <com.twinpad.android.app.surface.TwinpadControlView
        android:id="@+id/btn_b"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintCircle="@id/face_axis"
        app:layout_constraintCircleAngle="90"
        app:layout_constraintCircleRadius="60dp"
        app:twinpadHid="button_b"
        app:twinpadKind="button"
        app:twinpadLabel="B" />

</androidx.constraintlayout.widget.ConstraintLayout>
