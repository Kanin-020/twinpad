<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_gamepad_row"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="10dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp">

    <View
        android:id="@+id/row_dot"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_gamepad_dot"
        android:backgroundTint="@color/design_slate_edge" />

    <TextView
        android:id="@+id/row_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/inter"
        android:textColor="@color/design_cloud_white"
        android:textFontWeight="500"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter"
        android:gravity="end"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/design_misted_slate"
        android:textFontWeight="400"
        android:textSize="13sp" />
</LinearLayout>
