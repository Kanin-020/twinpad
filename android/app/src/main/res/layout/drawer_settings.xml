<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer de ajustes del stream (CR-001, CR-027; CR-029: sin selector
     de fps porque la emisión ya no se limita): resolución, bitrate,
     bitrate de video, HUD y controles táctiles; editable en Android Studio.
     CR-077: superficie Charcoal Panel con títulos Cloud White y etiquetas
     Misted Slate de DESIGN.md; nuevo origen de los gauges de espera. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/design_charcoal_panel"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/design_cloud_white"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_resolution"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/resolution_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CR-074: «Nativa» envía w/h = 0/0 (el Plugin publica el DRC tal cual). -->
            <RadioButton
                android:id="@+id/resolution_native"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nativa" />

            <RadioButton
                android:id="@+id/resolution_960x540"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="960×540" />

            <RadioButton
                android:id="@+id/resolution_1280x720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1280×720" />

            <RadioButton
                android:id="@+id/resolution_1920x1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1920×1080" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_scale"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/scale_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/scale_contain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_scale_contain" />

            <RadioButton
                android:id="@+id/scale_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_scale_expand" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_audio"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <SeekBar
            android:id="@+id/audio_volume_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_hud"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_fps" />

        <!-- CR-079 v12 (pedido del owner): el slider de métricas es una
             fila de la sección HUD (elemento de HUD sobre el stream), no de
             Debug — la ventana de espera aparece como hoja arrastrable
             sobre el video (nace abierta); desmarcado no se muestra. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_metrics_slider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_metrics_slider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_controls"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_controls" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_distribution"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- CR-034: distribución de los botones de cara; también el mando
             físico (SPEC-002 R19). -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_nintendo_distribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_nintendo_distribution" />

        <!-- CR-090: sección del micrófono, justo ENCIMA de la de cámara y con
             su mismo patrón (título + interruptor). La captura sigue siendo
             bajo demanda: el interruptor se suma al juego seleccionado y a
             `mic_request` (CR-035); desmarcado no se graba nada. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_microphone"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_microphone_stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_microphone_stream" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_camera"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- CR-034: opt-in del stream de cámara; los frames solo salen con
             el juego seleccionado Y demanda vigente (CR-038). -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_camera_stream"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_camera_stream" />

        <RadioGroup
            android:id="@+id/camera_lens_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/camera_lens_front"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_front" />

            <RadioButton
                android:id="@+id/camera_lens_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_camera_back" />
        </RadioGroup>

        <!-- CR-075: instrumentación de diagnóstico al final del drawer. -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_debug"
            android:textColor="@color/design_cloud_white"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <!-- CR-054: métricas por etapa del Plugin, opt-in, off por defecto. -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_advanced_metrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_advanced_metrics" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_gyro"
            android:textColor="@color/design_misted_slate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_gyro_monitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_gyro_monitor" />

        <Button
            android:id="@+id/btn_drawer_connection"
            style="@style/Widget.Twinpad.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/settings_connection_view"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_close_drawer"
            style="@style/Widget.Twinpad.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_close" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
