<?xml version="1.0" encoding="utf-8"?>
<!-- Drawer de ajustes del stream (CR-001, CR-027; CR-029: sin selector
     de fps porque la emisión ya no se limita): resolución, bitrate,
     bitrate de video, HUD y controles táctiles; editable en Android Studio. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_resolution"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/resolution_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/resolution_960x540"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="960×540" />

            <RadioButton
                android:id="@+id/resolution_1280x720"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1280×720" />

            <RadioButton
                android:id="@+id/resolution_1920x1080"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1920×1080" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_scale"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <RadioGroup
            android:id="@+id/scale_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/scale_contain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_scale_contain" />

            <RadioButton
                android:id="@+id/scale_expand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_scale_expand" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_bitrate"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <SeekBar
            android:id="@+id/bitrate_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="29000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_audio"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <SeekBar
            android:id="@+id/audio_volume_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_hud"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_fps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_fps" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_gyro"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_gyro_monitor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_gyro_monitor" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_controls"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_show_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_show_controls" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_distribution"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <!-- CR-032: distribución de los botones de cara; también el mando
             físico (SPEC-002 R19). -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_nintendo_distribution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_nintendo_distribution" />

        <Button
            android:id="@+id/btn_close_drawer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_close" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
