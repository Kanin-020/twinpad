<?xml version="1.0" encoding="utf-8"?>
<!-- Card de una conexión guardada (DESIGN.md: Charcoal Panel, radio 16 px). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/design_charcoal_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/design_slate_edge"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Punto verde: la conexión guardada está transmitiendo ahora. -->
            <ImageView
                android:id="@+id/saved_device_status"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/pairing_saved_active"
                android:src="@drawable/dot_stream_active"
                android:visibility="gone" />

            <TextView
                android:id="@+id/saved_device_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/design_cloud_white"
                android:textSize="16sp"
                android:textFontWeight="500" />
        </LinearLayout>

        <TextView
            android:id="@+id/saved_device_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/design_misted_slate"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saved_device_action"
            style="@style/Widget.Twinpad.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
