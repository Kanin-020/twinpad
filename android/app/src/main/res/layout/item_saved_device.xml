<?xml version="1.0" encoding="utf-8"?>
<!-- Card de una conexi\u00f3n guardada (DESIGN.md: Charcoal Panel, radio 16 px). -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/design_charcoal_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/design_slate_edge"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/saved_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/design_cloud_white"
            android:textSize="16sp"
            android:textFontWeight="500" />

        <TextView
            android:id="@+id/saved_device_addr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/design_misted_slate"
            android:textSize="13sp" />

        <Button
            android:id="@+id/saved_device_action"
            style="@style/Widget.Twinpad.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
