<?xml version="1.0" encoding="utf-8"?>
<!-- Pista de los interruptores del drawer: Signal Violet cuando está activado,
     Slate Edge cuando está desactivado (estados claramente distintos sobre el
     fondo Steel Panel del drawer). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/design_signal_violet" android:state_checked="true" />
    <item android:color="@color/design_slate_edge" />
</selector>
