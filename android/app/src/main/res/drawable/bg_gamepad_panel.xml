<?xml version="1.0" encoding="utf-8"?>
<!-- DESIGN.md: Floating Product Panel — Charcoal Panel con esquinas de 16 dp,
     borde Slate Edge de 1 px y un lavado violeta muy tenue en el borde
     superior (Violet Atmosphere) como única iluminación decorativa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/design_charcoal_panel" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#000F1219"
                android:startColor="#1F7064F2" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="@color/design_slate_edge" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
